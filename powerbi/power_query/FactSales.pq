// FactSales: Sales transactions at order-line grain (one row per product on an order).
// Grain: One row per OrderID + OrderLineNumber
// Generated by scripts/build_powerbi_assets.py. Requires the text parameter DataFolder
// (full path to data/processed/ ending with a backslash).
let
    Source = Csv.Document(File.Contents(DataFolder & "FactSales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    // Blank text in nullable columns -> null before typing (open orders have no ship date)
    BlanksToNull = Table.ReplaceValue(PromotedHeaders, "", null, Replacer.ReplaceValue, {"ShipDate", "DaysToShip"}),
    // Explicit types with en-US culture so ISO dates and decimal points parse identically on any PC
    ChangedTypes = Table.TransformColumnTypes(BlanksToNull, {
        {"SalesLineID", Int64.Type},
        {"OrderID", type text},
        {"OrderLineNumber", Int64.Type},
        {"OrderDate", type date},
        {"ShipDate", type date},
        {"OrderStatus", type text},
        {"DaysToShip", Int64.Type},
        {"CustomerKey", Int64.Type},
        {"ProductKey", Int64.Type},
        {"GeographyKey", Int64.Type},
        {"ChannelKey", Int64.Type},
        {"Quantity", Int64.Type},
        {"UnitPrice", Currency.Type},
        {"UnitCost", Currency.Type},
        {"DiscountPct", Percentage.Type},
        {"DiscountBand", type text},
        {"DiscountBandOrder", Int64.Type},
        {"GrossSales", Currency.Type},
        {"DiscountAmount", Currency.Type},
        {"SalesAmount", Currency.Type},
        {"CostAmount", Currency.Type},
        {"Profit", Currency.Type}
    }, "en-US")
in
    ChangedTypes
