// DimProduct: Product master with category hierarchy.
// Grain: One row per product
// Generated by scripts/build_powerbi_assets.py. Requires the text parameter DataFolder
// (full path to data/processed/ ending with a backslash).
let
    Source = Csv.Document(File.Contents(DataFolder & "DimProduct.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    // Explicit types with en-US culture so ISO dates and decimal points parse identically on any PC
    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {
        {"ProductKey", Int64.Type},
        {"ProductID", type text},
        {"ProductName", type text},
        {"Category", type text},
        {"Subcategory", type text},
        {"Brand", type text},
        {"ListPrice", Currency.Type},
        {"StandardCost", Currency.Type},
        {"PriceBand", type text},
        {"PriceBandOrder", Int64.Type}
    }, "en-US")
in
    ChangedTypes
