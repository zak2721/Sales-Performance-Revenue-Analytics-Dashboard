// DimCustomer: Customer master enriched with segmentation attributes (as of 2025-12-31).
// Grain: One row per customer
// Generated by scripts/build_powerbi_assets.py. Requires the text parameter DataFolder
// (full path to data/processed/ ending with a backslash).
let
    Source = Csv.Document(File.Contents(DataFolder & "DimCustomer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    // Blank text in nullable columns -> null before typing (open orders have no ship date)
    BlanksToNull = Table.ReplaceValue(PromotedHeaders, "", null, Replacer.ReplaceValue, {"FirstOrderDate", "LastOrderDate"}),
    // Explicit types with en-US culture so ISO dates and decimal points parse identically on any PC
    ChangedTypes = Table.TransformColumnTypes(BlanksToNull, {
        {"CustomerKey", Int64.Type},
        {"CustomerID", type text},
        {"CustomerName", type text},
        {"Segment", type text},
        {"CustomerSince", type date},
        {"FirstOrderDate", type date},
        {"LastOrderDate", type date},
        {"LifetimeOrders", Int64.Type},
        {"LifetimeSales", Currency.Type},
        {"ValueTier", type text},
        {"ValueTierOrder", Int64.Type},
        {"PurchaseFrequency", type text},
        {"PurchaseFrequencyOrder", Int64.Type}
    }, "en-US")
in
    ChangedTypes
