// DimSalesChannel: Sales channels.
// Grain: One row per channel
// Generated by scripts/build_powerbi_assets.py. Requires the text parameter DataFolder
// (full path to data/processed/ ending with a backslash).
let
    Source = Csv.Document(File.Contents(DataFolder & "DimSalesChannel.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    // Explicit types with en-US culture so ISO dates and decimal points parse identically on any PC
    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {
        {"ChannelKey", Int64.Type},
        {"ChannelCode", type text},
        {"ChannelName", type text},
        {"ChannelType", type text}
    }, "en-US")
in
    ChangedTypes
